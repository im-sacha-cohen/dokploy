# Copy to dev/.env to override. All ports are bound to 127.0.0.1 only.
DOKPLOY_DEV_UI_PORT=3000
# Traefik inside the devbox (port 80/443 are often taken on macOS).
DOKPLOY_DEV_HTTP_PORT=8880
DOKPLOY_DEV_HTTPS_PORT=8443
# 0 = start only the inner Docker daemon (useful to run tests without the dev server).
DEVBOX_AUTOSTART=1
# Local-only test owner account used by dev/demo-apps/seed.mjs (never a real password).
DOKPLOY_DEV_URL=http://localhost:3000
DEMO_ADMIN_EMAIL=owner@dokploy.test
DEMO_ADMIN_PASSWORD=change-me-local-only
